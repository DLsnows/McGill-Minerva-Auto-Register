# Email notifications (optional). Copy this file to `.env` and fill in real values.
# `.env` is gitignored — NEVER commit real credentials.
#
# See docs/EMAIL_SETUP.md for step-by-step setup (incl. Gmail app passwords).

# SMTP server host, e.g. smtp.gmail.com
AUTOREG_SMTP_HOST=smtp.gmail.com
# 587 (STARTTLS) or 465 (SSL)
AUTOREG_SMTP_PORT=587
# The sending account's address
AUTOREG_SMTP_USER=you@example.com
# App password / SMTP password (NOT your normal login password for Gmail)
AUTOREG_SMTP_PASS=your_app_password_here
# Where to send notification emails (can be the same as the sender)
AUTOREG_EMAIL_TO=you@example.com
